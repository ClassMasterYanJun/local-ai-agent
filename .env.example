# ============================================
# Конфигурация локальной ИИ-модели
# ============================================
# Скопируйте этот файл в .env и настройте под свои нужды:
#   Copy-Item .env.example .env
# ============================================

# --------------------------------------------
# Основные настройки
# --------------------------------------------

# Имя модели по умолчанию
# Варианты: llama3.2:3b, llama3.2:7b, llama3.2:latest, codellama:7b, mistral:7b, qwen2.5:7b
OLLAMA_MODEL=llama3.2:7b

# Базовый URL API Ollama
OLLAMA_HOST=http://localhost:11434

# --------------------------------------------
# Параметры генерации
# --------------------------------------------

# Температура (0.0 - 2.0)
# Низкие значения = более детерминированные ответы
# Высокие значения = более креативные ответы
OLLAMA_TEMPERATURE=0.7

# Максимальное количество токенов в ответе
OLLAMA_NUM_PREDICT=4096

# Top-p sampling (0.0 - 1.0)
OLLAMA_TOP_P=0.9

# Top-k sampling (0 - 100)
OLLAMA_TOP_K=40

# --------------------------------------------
# Производительность
# --------------------------------------------

# Количество параллельных запросов
OLLAMA_NUM_PARALLEL=1

# Количество GPU слоев (-1 = автоматически)
# Установите 0 для принудительного использования CPU
OLLAMA_NUM_GPU=-1

# Таймаут запроса в секундах
OLLAMA_TIMEOUT=120

# --------------------------------------------
# Память и кэш
# --------------------------------------------

# Путь к папке с моделями (по умолчанию: ~/.ollama)
# OLLAMA_MODELS=C:\Users\YourName\.ollama

# Максимальный размер контекста в токенах
OLLAMA_CONTEXT_WINDOW=8192

# --------------------------------------------
# Логирование
# --------------------------------------------

# Уровень логирования: debug, info, warn, error
OLLAMA_LOG_LEVEL=info

# Путь к файлу логов (опционально)
# OLLAMA_LOG_FILE=C:\AIModel\logs\ollama.log

# --------------------------------------------
# Прокси (опционально)
# --------------------------------------------

# HTTP прокси для загрузки моделей
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# --------------------------------------------
# Дополнительные параметры
# --------------------------------------------

# Системный промпт (инструкция для модели)
# OLLAMA_SYSTEM_PROMPT="You are a helpful AI assistant that responds in Russian."

# Формат ответа: json или текст
# OLLAMA_FORMAT=json

# Seed для воспроизводимости результатов (опционально)
# OLLAMA_SEED=42
